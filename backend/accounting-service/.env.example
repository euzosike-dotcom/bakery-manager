# Must be the least-privilege `accounting_svc` role
# (infra/postgres/migrations/015_accounting_rls_and_role.sql), NOT the
# `metrock` bootstrap role — see procurement-service/.env.example for why.
DATABASE_URL="postgresql://accounting_svc:accounting_svc_dev_password@localhost:5432/metrock_erp?schema=public"
KAFKA_BROKERS="localhost:9092"
# Independent consumer group from ledger-service's — both read erp.events,
# each maintains its own offsets, neither knows the other exists.
KAFKA_CONSUMER_GROUP="accounting-service"
GOVERNANCE_BASE_URL="http://localhost:3008"
PORT=3004
