# Must be the least-privilege `finance_connector_svc` role
# (infra/postgres/migrations/025_finance_connector.sql), NOT the `metrock`
# bootstrap role — see procurement-service/.env.example for why.
DATABASE_URL="postgresql://finance_connector_svc:finance_connector_svc_dev_password@localhost:5432/metrock_erp?schema=public"
KEYCLOAK_ISSUER="https://localhost:8543/realms/metrock"
PORT=3009

# How often the background poller (FinanceConnectorService) checks
# integration_queue for PENDING rows tagged for the CUSTOM_MODULE
# connector. No M2M client / governance-service call needed here, unlike
# every request-serving domain service's PostingAuthorityClient — this is
# an automated background relay, not a user-initiated posting action
# (same reasoning ledger-service's own PostingEngine already relies on).
POLL_INTERVAL_MS=5000

# Comma-separated browser origins to allow via CORS (e.g. the future Web
# Console client, docs/SDD.md's client-layer diagram). Unset by default —
# nothing today calls this API from a browser (only curl — this service
# has no Flutter-facing surface at all, not even indirectly through the
# gateway, same as governance-service). Never a bare wildcard when set;
# see @metrock/backend-common's applySecurityMiddleware for the full
# reasoning.
# CORS_ALLOWED_ORIGINS="https://app.metrock.example"
