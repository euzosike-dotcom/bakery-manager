# Must be the least-privilege `governance_svc` role
# (infra/postgres/migrations/021_governance_role.sql), NOT the `metrock`
# bootstrap role — see procurement-service/.env.example for why.
DATABASE_URL="postgresql://governance_svc:governance_svc_dev_password@localhost:5432/metrock_erp?schema=public"
# No trailing slash; verifyKeycloakToken appends the OIDC well-known
# JWKS path itself.
KEYCLOAK_ISSUER="https://localhost:8543/realms/metrock"
# Machine-to-machine auth (docs/RUNBOOK.md) — the Keycloak client ids
# M2MAuthMiddleware accepts as legitimate callers of
# /authorization-check and /approval-check. One confidential client per
# calling service (infra/keycloak/realm-export.json), not shared.
M2M_ALLOWED_CLIENT_IDS="procurement-service,sales-service,accounting-service,fleet-service,hr-service,manufacturing-service,finance-connector-service"
PORT=3008

# Comma-separated browser origins to allow via CORS (e.g. the future Web
# Console client, docs/SDD.md's client-layer diagram). Unset by default —
# nothing today calls this API from a browser (only the native Flutter
# app + curl, neither subject to CORS), so leaving this empty changes
# nothing. Never a bare wildcard when set; see @metrock/backend-common's
# applySecurityMiddleware for the full reasoning.
# CORS_ALLOWED_ORIGINS="https://app.metrock.example"
