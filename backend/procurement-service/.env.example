# Must be the least-privilege `procurement_svc` role (infra/postgres/migrations/007_app_role.sql),
# NOT the `metrock` bootstrap role — that role is a Postgres superuser and
# silently bypasses Row-Level Security, defeating the DB-layer isolation
# backstop (see docs/SDD.md §1.2).
DATABASE_URL="postgresql://procurement_svc:procurement_svc_dev_password@localhost:5432/metrock_erp?schema=public"
KAFKA_BROKERS="localhost:9092"
KEYCLOAK_ISSUER="http://localhost:8080/realms/metrock"
# governance-service base URL — used by PostingAuthorityClient for the
# PO approve/reject endpoints' amount-routed approval_matrix check.
GOVERNANCE_BASE_URL="http://localhost:3008"
PORT=3001
