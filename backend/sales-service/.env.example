# Must be the least-privilege `sales_svc` role
# (infra/postgres/migrations/011_sales_rls_and_role.sql), NOT the `metrock`
# bootstrap role — see procurement-service/.env.example for why.
DATABASE_URL="postgresql://sales_svc:sales_svc_dev_password@localhost:5432/metrock_erp?schema=public"
KAFKA_BROKERS="localhost:9092"
GOVERNANCE_BASE_URL="http://localhost:3008"
KEYCLOAK_ISSUER="https://localhost:8543/realms/metrock"
# Machine-to-machine auth (docs/RUNBOOK.md) — this service's own
# registered Keycloak client (infra/keycloak/realm-export.json),
# client-credentials grant only, not shared with any other service.
# M2MTokenClient uses these to mint the Bearer token PostingAuthorityClient
# attaches on its calls to governance-service.
M2M_CLIENT_ID="sales-service"
M2M_CLIENT_SECRET="sales-service-m2m-dev-secret"
PORT=3003

# Comma-separated browser origins to allow via CORS (e.g. the future Web
# Console client, docs/SDD.md's client-layer diagram). Unset by default —
# nothing today calls this API from a browser (only the native Flutter
# app + curl, neither subject to CORS), so leaving this empty changes
# nothing. Never a bare wildcard when set; see @metrock/backend-common's
# applySecurityMiddleware for the full reasoning.
# CORS_ALLOWED_ORIGINS="https://app.metrock.example"
