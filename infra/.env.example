# docker compose (run from infra/) reads a .env file in this same
# directory automatically — copy this to infra/.env to override any of
# these. Uncommitted (see .gitignore's .env/.env.* pattern, same as every
# backend service's own .env), matching this repo's established
# secrets convention.
#
# These are the SAME well-known local-dev defaults docker-compose.yml
# falls back to when infra/.env doesn't exist at all — copying this file
# changes nothing by itself. It exists so you have somewhere to put real
# overrides, not because the defaults below are secret.
#
# IMPORTANT: these values are committed, publicly-known local-dev
# credentials, not real secrets — see README "Known gaps" for why that's
# fine for this stack and what a real deployment would need to do instead
# (a secrets manager, none of which this repo wires up). The per-service
# DB role passwords in infra/postgres/migrations/*_role.sql follow the
# same well-known-default pattern but are no longer hardcoded literals —
# each file reads its password from a psql variable with this same value
# as the fallback, so a real deployment can override via `-v` instead of
# editing a tracked file. See docs/RUNBOOK.md's "Secrets in production".

POSTGRES_USER=metrock
POSTGRES_PASSWORD=metrock_dev_password

MINIO_ROOT_USER=metrock
MINIO_ROOT_PASSWORD=metrock_dev_password

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
