# Must be the least-privilege `manufacturing_svc` role
# (infra/postgres/migrations/009_manufacturing_rls_and_role.sql), NOT the
# `metrock` bootstrap role — see procurement-service/.env.example for why.
DATABASE_URL="postgresql://manufacturing_svc:manufacturing_svc_dev_password@localhost:5432/metrock_erp?schema=public"
KAFKA_BROKERS="localhost:9092"
KEYCLOAK_ISSUER="https://localhost:8543/realms/metrock"
# governance-service base URL, and this service's own registered
# Keycloak client (infra/keycloak/realm-export.json) for the
# machine-to-machine auth PostingAuthorityClient needs (docs/RUNBOOK.md)
# — added as part of the approval_matrix expansion pass (retrospective
# batch-cost review), this service never called governance-service
# before it.
GOVERNANCE_BASE_URL="http://localhost:3008"
M2M_CLIENT_ID="manufacturing-service"
M2M_CLIENT_SECRET="manufacturing-service-m2m-dev-secret"
PORT=3002

# Comma-separated browser origins to allow via CORS (e.g. the future Web
# Console client, docs/SDD.md's client-layer diagram). Unset by default —
# nothing today calls this API from a browser (only the native Flutter
# app + curl, neither subject to CORS), so leaving this empty changes
# nothing. Never a bare wildcard when set; see @metrock/backend-common's
# applySecurityMiddleware for the full reasoning.
# CORS_ALLOWED_ORIGINS="https://app.metrock.example"
