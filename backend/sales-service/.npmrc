# file:../../packages/backend-common must be COPIED into node_modules, not
# symlinked (npm's default for local file: deps). A symlink resolves to its
# real path outside this service's node_modules tree entirely, so Node's
# module resolution walk-up can never find this service's own hoisted
# @nestjs/common/@prisma/client — MODULE_NOT_FOUND at runtime, not at
# install or compile time, which is what makes this gotcha easy to miss.
install-links=true
